   VALUE "ProductName", "@PROJECT_NAME@\0"
   VALUE "CompanyName", "@DESKTOPPET_DEVELOPER_ESCAPED@\0"
   VALUE "LegalCopyright", "@DESKTOPPET_COPYRIGHT_ESCAPED@\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
